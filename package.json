{
  "name": "iac33",
  "version": "0.3.1",
  "private": true,
  "description": "IAC33 - Intelligent analysis and probabilistic research platform",
  "type": "module",
  "engines": {
    "node": "^20.11.0",
    "npm": "^10.2.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "verify:foundation": "node scripts/verify-foundation.mjs",
    "test": "vitest run",
    "test:memory": "vitest run tests/memory.integration.test.mjs",
    "test:learning": "vitest run tests/learning-control.test.mjs",
    "test:phase4": "vitest run tests/phase4-tool-router.test.ts",
    "test:phase5": "vitest run tests/phase5-agent-loop.test.ts",
    "test:phase6": "vitest run tests/phase6-gateway.test.mjs",
    "test:phase7": "vitest run tests/phase7-hardening.test.mjs",
    "test:phase8": "vitest run tests/phase8-bridge.test.ts",
    "test:phase9": "vitest run tests/phase9-autonomous.test.ts",
    "test:phase10": "vitest run tests/phase10-system-runtime.test.ts",
    "test:phase11": "vitest run tests/phase11-autonomous-production.test.ts",
    "test:phase12": "vitest run tests/phase12-runtime-integration.test.ts",
    "test:phase13": "vitest run tests/phase13-tool-router-2.test.ts",
    "test:phase14": "vitest run tests/phase14-android-bridge-v2.test.ts",
    "test:phase15": "vitest run tests/phase15-observability-hardening.test.ts",
    "test:phase16": "vitest run tests/phase16-tool-gateway.test.mjs",
    "test:phase17": "vitest run tests/android-bridge-v3.test.ts",
    "test:phase18": "vitest run tests/phase18-bridge-gateway.test.mjs",
    "test:phase19": "vitest run tests/phase19-bridge-persistence.test.mjs",
    "test:phase20": "vitest run tests/phase20-android-bridge-inbox-client.test.ts",
    "test:phase21": "vitest run tests/phase21-android-bridge-executor.test.ts",
    "test:phase22": "vitest run tests/phase22-capacitor-bridge.test.ts",
    "test:phase23": "vitest run tests/phase23-native-android-bridge.test.ts",
    "test:bridge-hardening": "vitest run tests/android-bridge-v3.test.ts",
    "backend": "node --import tsx server/server.mjs",
    "backend:dev": "node --import tsx --watch server/server.mjs"
  },
  "dependencies": {
    "@capacitor/android": "7.4.4",
    "@capacitor/core": "7.4.4",
    "@fastify/cors": "11.0.0",
    "@fastify/rate-limit": "11.2.0",
    "@ffprobe-installer/ffprobe": "2.1.2",
    "fastify": "5.12.4",
    "ffmpeg-static": "5.2.0",
    "fluent-ffmpeg": "2.1.3",
    "pg": "8.16.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "4.20.5"
  },
  "devDependencies": {
    "@capacitor/cli": "7.4.4",
    "@types/node": "20.10.0",
    "@types/pg": "8.15.5",
    "@types/react": "18.3.0",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.2.1",
    "terser": "5.43.1",
    "typescript": "5.3.3",
    "vite": "5.0.8",
    "vitest": "2.1.9"
  }
}
