VITE_STORAGE_BACKEND=localStorage
VITE_AUTONOMY_LEVEL=restricted
VITE_DEBUG=false
VITE_ANDREW_BACKEND_URL=https://YOUR-BACKEND.example.com

# Backend-only variables. Never put these in VITE_* variables or the APK.
OPENAI_API_KEY=replace-on-server-only
OPENAI_MODEL=gpt-5.6-luna

# Optional secondary provider. Leave empty to use primary + local degraded mode.
AI_SECONDARY_API_KEY=
AI_SECONDARY_ENDPOINT=
AI_SECONDARY_MODEL=deepseek-chat

CORS_ORIGINS=https://YOUR-FRONTEND.example.com
MAX_BODY_BYTES=65536
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
