APP_NAME=andrew-cortex
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO
CORTEX_SHARED_TOKEN=replace-with-long-random-secret

REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=andrew_memory

LITELLM_BASE_URL=http://litellm:4000
LITELLM_MASTER_KEY=replace-with-long-random-secret
LITELLM_TIMEOUT_SECONDS=30

PRIMARY_MODEL=replace-primary-model
PRIMARY_API_KEY=replace-primary-key
PRIMARY_API_BASE=https://api.openai.com/v1
SECONDARY_MODEL=replace-secondary-model
SECONDARY_API_KEY=replace-secondary-key
SECONDARY_API_BASE=https://api.openai.com/v1
CODE_MODEL=replace-code-model
CODE_API_KEY=replace-code-key
CODE_API_BASE=https://api.openai.com/v1
MULTIMODAL_MODEL=replace-multimodal-model
MULTIMODAL_API_KEY=replace-multimodal-key
MULTIMODAL_API_BASE=https://api.openai.com/v1
LOCAL_MODEL=replace-local-model
LOCAL_VLLM_BASE_URL=http://vllm:8000/v1
LOCAL_VLLM_API_KEY=local-dev-key
HF_TOKEN=replace-huggingface-token

EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SPARSE_EMBEDDING_MODEL=Qdrant/bm25
EMBEDDING_DIM=384
CACHE_SIMILARITY_THRESHOLD=0.94
CACHE_TTL_SECONDS=3600
RAG_TOP_K=8
RAG_MAX_CONTEXT_CHARS=24000
MAX_CONCURRENT_REQUESTS=64
P0_QUEUE_SIZE=16
P1_QUEUE_SIZE=64
P2_QUEUE_SIZE=128
P3_QUEUE_SIZE=128
P4_QUEUE_SIZE=64
MEMORY_MAX_SCAN_KEYS=256

SYSTEM_PROMPT_VERSION=v1
MODEL_VERSION_ROUTING=v1
